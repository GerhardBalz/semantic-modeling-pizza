@prefix smp: <https://github.com/GerhardBalz/semantic-modeling-pizza#> .
@prefix smo: <https://w3id.org/smo#> .
@prefix dcterms: <http://purl.org/dc/terms/> .

smp:PizzaMenuSemanticModel
    a smo:SemanticModel ;
    dcterms:title "Broken Pizza Menu Semantic Model"@en ;
    dcterms:description "A deliberately invalid semantic model without a source model."@en ;
    dcterms:conformsTo smp:PizzaMenuSemanticModelShape ;
    dcterms:hasFormat smp:BrokenRepresentation ;
    dcterms:hasPart smp:MenuItem ;
    smp:answersQuestion
        "Question one?"@en,
        "Question two?"@en,
        "Question three?"@en ;
    smp:excludesElement smp:ExcludedElement .
