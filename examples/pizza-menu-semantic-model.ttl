@prefix smp: <https://github.com/GerhardBalz/semantic-modeling-pizza#> .
@prefix smo: <https://w3id.org/smo#> .
@prefix mod: <https://w3id.org/mod#> .
@prefix pizza: <http://www.co-ode.org/ontologies/pizza/pizza.owl#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

smp:PizzaMenuSemanticModel
    a smo:SemanticModel ;
    dcterms:title "Pizza Menu Semantic Model"@en ;
    dcterms:description "A menu-oriented semantic model for representing offered pizzas and supporting explainable recommendations."@en ;
    dcterms:source <http://www.co-ode.org/ontologies/pizza> ;
    prov:wasDerivedFrom <http://www.co-ode.org/ontologies/pizza> ;
    dcterms:conformsTo smp:PizzaMenuSemanticModelShape, smp:MenuItemShape ;
    dcterms:hasFormat smp:PizzaMenuSemanticModelTurtle ;
    mod:competencyQuestion
        "Which pizzas are currently offered on the menu?"@en,
        "Which toppings are associated with a pizza?"@en,
        "Which offered pizzas satisfy a dietary or spiciness preference?"@en,
        "What evidence supports a recommendation?"@en ;
    smp:excludesElement pizza:Country, pizza:IceCream ;
    dcterms:hasPart
        pizza:Pizza,
        pizza:NamedPizza,
        pizza:Margherita,
        pizza:VegetarianPizza,
        pizza:SpicyPizza,
        pizza:PizzaBase,
        pizza:PizzaTopping,
        pizza:SpicyTopping,
        pizza:Spiciness,
        pizza:hasBase,
        pizza:hasTopping,
        pizza:hasSpiciness,
        smp:MenuItem,
        smp:offersPizza,
        smp:price,
        smp:available,
        smp:DietaryPreference,
        smp:RecommendationEvidence .

smp:PizzaMenuSemanticModelTurtle
    dcterms:title "Pizza Menu Semantic Model — Turtle representation"@en ;
    dcterms:identifier "examples/pizza-menu-semantic-model.ttl" ;
    dcterms:format "text/turtle" .

smp:excludesElement
    a owl:ObjectProperty ;
    rdfs:domain smo:SemanticModel ;
    rdfs:label "excludes element"@en ;
    rdfs:comment "Identifies a source-model element intentionally excluded from a purpose-specific semantic model. Experimental local property."@en .

smp:MenuItem
    a owl:Class ;
    rdfs:label "Menu item"@en .

smp:offersPizza
    a owl:ObjectProperty ;
    rdfs:domain smp:MenuItem ;
    rdfs:range pizza:Pizza ;
    rdfs:label "offers pizza"@en .

smp:price
    a owl:DatatypeProperty ;
    rdfs:domain smp:MenuItem ;
    rdfs:range xsd:decimal ;
    rdfs:label "price"@en .

smp:available
    a owl:DatatypeProperty ;
    rdfs:domain smp:MenuItem ;
    rdfs:range xsd:boolean ;
    rdfs:label "available"@en .

smp:DietaryPreference
    a owl:Class ;
    rdfs:label "Dietary preference"@en .

smp:RecommendationEvidence
    a owl:Class ;
    rdfs:label "Recommendation evidence"@en .

smp:RuntimeContext a owl:Class .

smp:RestaurantMenuContext
    a smp:RuntimeContext ;
    dcterms:title "Restaurant menu context"@en ;
    dcterms:description "The runtime context in which currently available menu items are searched and recommended."@en .
